# ==========================================
# BLOG BUILDER - Environment Variables Template
# ==========================================

# ===== SHOPIFY CREDENTIALS =====
# Managed by Shopify CLI in .shopify/ folder (NOT in .env!)
# CLI handles authentication via Partners account
# No need to manually set SHOPIFY_API_KEY or SHOPIFY_API_SECRET

# ===== DATABASE =====

# Prisma (SQLite for OAuth sessions)
# Default: SQLite database in prisma/dev.sqlite
DATABASE_URL=file:./dev.sqlite

# MongoDB (business data - optional, future use)
# Get free M0 cluster from: https://www.mongodb.com/cloud/atlas
# MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/blog-builder

# ===== APP CONFIGURATION =====

# Node Environment
NODE_ENV=development

# Shopify Scopes (also defined in shopify.app.toml)
SCOPES=write_products,read_content,write_content

# ===== EXTERNAL SERVICES (add when needed) =====

# Monitoring (when added)
# SENTRY_DSN=https://...

# Email (when added)
# RESEND_API_KEY=re_...

# Analytics (when added)
# POSTHOG_API_KEY=phc_...